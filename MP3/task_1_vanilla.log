        if (str.isEmpty()) {
            return "";
        }

        int beginningOfSuffix = 0;

        while (!isPalindrome(str.substring(beginningOfSuffix))) {
            beginningOfSuffix++;
        }

        return str + new StringBuilder(str.substring(0, beginningOfSuffix)).reverse().toString();
