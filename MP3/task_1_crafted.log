import java.util.*;
import java.lang.*;

class Solution {
    public int primeFib(int n) {
        List<Integer> f = new ArrayList<>(Arrays.asList(0, 1));
        while (true) {
            f.add(f.get(f.size() - 1) + f.get(f.size() - 2));
            if (isPrime(f.get(f.size() - 1))) {
                n -= 1;
            }
            if (n == 0) {
                return f.get(f.size() - 1);
            }
        }
    }

    private boolean isPrime(int p) {
        if (p < 2) {
            return false;
        }
        for (int k = 2; k <= Math.min(p - 1, (int) Math.sqrt(p)); k++) {
            if (p % k == 0) {
                return false;
            }
        }
        return true;
    }
}

