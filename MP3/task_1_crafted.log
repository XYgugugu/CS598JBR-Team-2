    public List<Integer> strangeSortList(List<Integer> lst) {
        List<Integer> res = new ArrayList<>();
        boolean switchVal = true;
        while (!lst.isEmpty()) {
            int minOrMax = switchVal ? Collections.min(lst) : Collections.max(lst);
            res.add(minOrMax);
            lst.remove(Integer.valueOf(minOrMax));
            switchVal = !switchVal;
        }
        return res;
    }
}

public class Main {
