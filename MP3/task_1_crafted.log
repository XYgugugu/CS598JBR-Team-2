import java.util.*;
import java.lang.*;

class Solution {
    public List<Integer> reverseThird(List<Integer> l) {
        // l = list(l) makes a copy.
        List<Integer> result = new ArrayList<>(l);
        // l[::3] starts at index 0 and takes every third element: indices 0, 3, 6, ...
        List<Integer> thirds = new ArrayList<>();
        for (int i = 0; i < result.size(); i += 3) {
            thirds.add(result.get(i));
        }
        Collections.reverse(thirds);
        // Assigning to l[::3] writes the values back to indices 0, 3, 6, ...
        for (int i = 0; i < result.size(); i += 3) {
            result.set(i, thirds.get(i / 3));
        }
        return result;
    }
}
